# Copy to .env.local and enter the key locally. Never commit .env.local.
ANTHROPIC_API_KEY=
# Required only for keys that are not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
# Choose a Messages API model available to your Claude Console project.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Production calls are disabled by default until authentication/quotas are ready.
AI_CHAT_ENABLED=false

# 교수 카드 생성: 인증 구현 전에는 신뢰할 수 있는 로컬 프로덕션 테스트에서만 활성화
AI_CARDS_ENABLED=false

# 학생 기록 저장소: local(브라우저 저장 + 예시 채점) | server(학생 API, Supabase)
NEXT_PUBLIC_STORE_MODE=local
# 학생 API(/api/student/*): 인증 구현 전에는 운영(next start) 환경에서 닫혀 있다. 신뢰할 수 있는 로컬 시연에서만 true
STUDENT_API_ENABLED=false

# Supabase 서버 DB 전용. 실제 값은 .env.local에만 입력
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 로그인 인증 전용 publishable 또는 legacy anon key (DB secret key와 별도)
SUPABASE_PUBLISHABLE_KEY=
# 서버의 학번/교번 -> 사전 생성된 Auth 이메일 매핑. 비밀번호를 넣지 않음.
AUTH_MEMBER_EMAILS={}

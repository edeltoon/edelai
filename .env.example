# Copy to .env.local and enter the key locally. Never commit .env.local.
ANTHROPIC_API_KEY=
# Required only for keys that are not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
# Choose a Messages API model available to your Claude Console project.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Production calls are disabled by default until authentication/quotas are ready.
AI_CHAT_ENABLED=false

# 교수 카드 생성: 인증 구현 전에는 신뢰할 수 있는 로컬 프로덕션 테스트에서만 활성화
AI_CARDS_ENABLED=false

# 학생 기록 저장소: local(브라우저 저장 + 학생 화면 예시 채점, 기본) | server(/api/student/* 서버 API, Supabase)
# (이전 NEXT_PUBLIC_CHALLENGE_API=mock|live는 이 변수로 통합: mock → local, live → server)
NEXT_PUBLIC_STORE_MODE=local

# Supabase (서버 전용. NEXT_PUBLIC_ 접두사 금지, 값은 .env.local에만)
# 프로젝트 URL: https://<project-ref>.supabase.co
SUPABASE_URL=
# secret key(sb_secret_…). 모든 테이블 RLS를 우회하므로 절대 브라우저·저장소에 넣지 않는다
SUPABASE_SECRET_KEY=
